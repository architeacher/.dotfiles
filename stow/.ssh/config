# ssh keeps the first value it reads for each option: host files first, the Host * defaults last.
# A new file in conf.d needs its own Include line above conf.d/common.
Include ~/.ssh/conf.d/private
Include ~/.ssh/conf.d/work
Include ~/.dotfiles/private/.ssh/conf.d/*
Include ~/.ssh/conf.d/common

# Added by OrbStack: 'orb' SSH host for Linux machines
# This only works if it's at the top of ssh_config (before any Host blocks).
# Comment this line if you don't want it to be added again.
#Include ~/.orbstack/ssh/config
