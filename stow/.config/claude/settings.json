{
  "awsAuthRefresh": "aws sso login --profile Claude",
  "skillListingBudgetFraction": 0.03,
  "env": {
    "CLAUDE_CODE_USE_ANTHROPIC_AWS": "1",
    "AWS_PROFILE": "Claude",
    "ENABLE_TOOL_SEARCH": "true",
    "CLAUDE_CODE_ENABLE_AWAY_SUMMARY": "true",
    "CLAUDE_CODE_ENABLE_TELEMETRY": "true",
    "OTEL_EXPORTER_OTLP_PROTOCOL": "http/protobuf",
    "OTEL_LOGS_EXPORTER": "otlp",
    "OTEL_METRICS_EXPORTER": "otlp"
  },
  "permissions": {
    "allow": [
      "Bash(buf breaking *)",
      "Bash(buf build *)",
      "Bash(buf format *)",
      "Bash(buf generate *)",
      "Bash(buf lint *)",
      "Bash(cargo --version)",
      "Bash(cargo build *)",
      "Bash(cargo check *)",
      "Bash(cargo clippy *)",
      "Bash(cargo doc *)",
      "Bash(cargo fmt *)",
      "Bash(cargo metadata *)",
      "Bash(cargo test *)",
      "Bash(cargo tree *)",
      "Bash(docker compose ps *)",
      "Bash(docker compose logs *)",
      "Bash(docker ps *)",
      "Bash(fd *)",
      "Bash(git blame *)",
      "Bash(git branch *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git rev-parse *)",
      "Bash(git show *)",
      "Bash(git stash *)",
      "Bash(git switch *)",
      "Bash(git worktree *)",
      "Bash(go build *)",
      "Bash(go doc *)",
      "Bash(go env *)",
      "Bash(go list *)",
      "Bash(go mod tidy)",
      "Bash(go test *)",
      "Bash(go vet *)",
      "Bash(go version)",
      "Bash(gofmt *)",
      "Bash(jq *)",
      "Bash(lsof *)",
      "Bash(make build *)",
      "Bash(make lint *)",
      "Bash(make test *)",
      "Bash(rg *)",
      "Bash(rustc --version)",
      "Bash(rustup show *)",
      "Bash(sed -n *)",
      "Bash(tree *)",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:*.github.com)",
      "WebFetch(domain:raw.githubusercontent.com)",
      "WebFetch(domain:medium.com)",
      "WebFetch(domain:*.medium.com)",
      "WebFetch(domain:docs.rs)",
      "WebFetch(domain:doc.rust-lang.org)",
      "WebSearch",
      "mcp__ide__getDiagnostics",
      "mcp__pencil",
      "mcp__plugin_playwright_playwright__browser_click",
      "mcp__plugin_playwright_playwright__browser_close",
      "mcp__plugin_playwright_playwright__browser_console_messages",
      "mcp__plugin_playwright_playwright__browser_fill_form",
      "mcp__plugin_playwright_playwright__browser_hover",
      "mcp__plugin_playwright_playwright__browser_navigate_back",
      "mcp__plugin_playwright_playwright__browser_network_requests",
      "mcp__plugin_playwright_playwright__browser_press_key",
      "mcp__plugin_playwright_playwright__browser_resize",
      "mcp__plugin_playwright_playwright__browser_select_option",
      "mcp__plugin_playwright_playwright__browser_snapshot",
      "mcp__plugin_playwright_playwright__browser_tabs",
      "mcp__plugin_playwright_playwright__browser_take_screenshot",
      "mcp__plugin_playwright_playwright__browser_type",
      "mcp__plugin_playwright_playwright__browser_wait_for"
    ],
    "deny": [
      "Bash(git push --force *)",
      "Bash(git push * --force)",
      "Bash(git push * --force *)",
      "Bash(git push -f *)",
      "Bash(git push * -f)",
      "Bash(git push * -f *)",
      "Bash(git push * +*)",
      "Edit(**/.git/config)",
      "Edit(**/.git/hooks/**)",
      "mcp__plugin_playwright_playwright__browser_run_code_unsafe",
      "mcp__plugin_playwright_playwright__browser_file_upload",
      "Read(~/.aws/**)",
      "Read(~/.cargo/credentials*)",
      "Read(~/.config/gh/**)",
      "Read(~/.config/sops/**)",
      "Read(~/.docker/config.json)",
      "Read(**/.env.local)",
      "Read(**/.env.*.local)",
      "Read(~/.git-credentials)",
      "Read(~/.gnupg/**)",
      "Read(~/.kube/**)",
      "Read(~/.local/share/gnupg/**)",
      "Read(~/.netrc)",
      "Read(~/.npmrc)",
      "Read(~/.ssh/**)"
    ],
    "ask": [
      "Bash(cargo * --config*)",
      "Bash(cargo add *)",
      "Bash(cargo install *)",
      "Bash(cargo publish *)",
      "Bash(cargo run *)",
      "Bash(cargo update *)",
      "Bash(docker compose exec *)",
      "Bash(fd *-x*)",
      "Bash(fd *-X*)",
      "Bash(fd *--exec*)",
      "Bash(git add *)",
      "Bash(git branch *--delete*)",
      "Bash(git branch *--force*)",
      "Bash(git branch -D *)",
      "Bash(git branch -M *)",
      "Bash(git branch -f *)",
      "Bash(git checkout *)",
      "Bash(git clean *)",
      "Bash(git commit *)",
      "Bash(git config *)",
      "Bash(git diff *--output*)",
      "Bash(git fetch *)",
      "Bash(git log *--output*)",
      "Bash(git merge *)",
      "Bash(git push *)",
      "Bash(git push *--force-with-lease*)",
      "Bash(git rebase *)",
      "Bash(git reset *)",
      "Bash(git restore *)",
      "Bash(git stash clear*)",
      "Bash(git stash drop *)",
      "Bash(git switch *--discard-changes*)",
      "Bash(git switch *--force*)",
      "Bash(git switch * -f*)",
      "Bash(git switch -C *)",
      "Bash(git worktree prune*)",
      "Bash(git worktree remove *)",
      "Bash(go * -exec*)",
      "Bash(go * -toolexec*)",
      "Bash(go env -u *)",
      "Bash(go env -w *)",
      "Bash(go vet *-vettool*)",
      "Bash(make * --eval*)",
      "Bash(make * --file*)",
      "Bash(make * -f *)",
      "Bash(rm *)",
      "Bash(rg *--pre*)",
      "Bash(tree *-o *)",
      "Read(**/.env)",
      "mcp__plugin_playwright_playwright__browser_evaluate",
      "mcp__plugin_playwright_playwright__browser_navigate"
    ],
    "defaultMode": "auto"
  },
  "model": "opus[1m]",
  "hooks": {
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[[ \"${CLAUDE_QUIET}\" = \"true\" ]] && exit 0; afplay \"${XDG_CONFIG_HOME}/claude/hooks/mario-fart-sound-effect.mp3\""
          },
          {
            "type": "command",
            "command": "[[ \"${CLAUDE_QUIET}\" = \"true\" ]] && exit 0; osascript -e \"display notification \\\"Attention is needed.\\\" with title\\\"Claude\\\" subtitle \\\"$(basename \"${CLAUDE_PROJECT_DIR}\") Project\\\" sound name \\\"codex-alert-codex-notification\\\"\"",
            "async": true
          },
          {
            "type": "command",
            "command": "[[ \"${CLAUDE_QUIET}\" = \"true\" ]] && exit 0; say -v Albert \"Claude needs your attention on $(basename \"${CLAUDE_PROJECT_DIR}\") project\" </dev/null;",
            "async": true
          },
          {
            "type": "command",
            "command": "[[ \"${CLAUDE_QUIET}\" = \"true\" ]] && exit 0; jq -r '.message' | curl -s -d @- https://ntfy.sh/architeacher-Claude",
            "async": true
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[[ \"${CLAUDE_QUIET}\" = \"true\" ]] && exit 0; say -v Whisper \"Claude needs your permission on $(basename \"${CLAUDE_PROJECT_DIR}\") project\" </dev/null;"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "[[ \"${CLAUDE_QUIET}\" = \"true\" ]] && exit 0; afplay \"${XDG_CONFIG_HOME}/claude/hooks/super-mario-stage-win-sound-effect.mp3\";"
          },
          {
            "type": "command",
            "command": "[[ \"${CLAUDE_QUIET}\" = \"true\" ]] && exit 0; open \"raycast://confetti\";",
            "async": true
          },
          {
            "type": "command",
            "command": "[[ \"${CLAUDE_QUIET}\" = \"true\" ]] && exit 0; voices=(\"Bells\" \"Boing\" \"Cellos\" \"Good\" \"Organ\" \"Trinoids\" \"Zarvox\"); say -v \"${voices[RANDOM % ${#voices[@]}]}\" \"Mission accomplished on $(basename \"${CLAUDE_PROJECT_DIR}\") project\" </dev/null;",
            "async": true
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "[[ \"${CLAUDE_QUIET}\" = \"true\" ]] && exit 0; afplay \"${XDG_CONFIG_HOME}/claude/hooks/super-mario-bros-underground-sound effect.mp3\"",
            "async": true
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "${XDG_CONFIG_HOME}/claude/status_line.sh"
  },
  "enabledPlugins": {
    "code-review@claude-plugins-official": true,
    "code-simplifier@claude-plugins-official": true,
    "explanatory-output-style@claude-plugins-official": true,
    "learning-output-style@claude-plugins-official": true,
    "gopls-lsp@claude-plugins-official": true,
    "rust-analyzer-lsp@claude-plugins-official": true,
    "security-guidance@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true,
    "claude-jira-skill@anthropic-plugin-directory": true,
    "playwright@claude-plugins-official": true,
    "i-have-adhd@i-have-adhd": true,
    "caveman@caveman": true,
    "ponytail@ponytail": true
  },
  "extraKnownMarketplaces": {
    "i-have-adhd": {
      "source": {
        "source": "github",
        "repo": "ayghri/i-have-adhd",
        "ref": "v0.4.1"
      },
      "autoUpdate": false
    },
    "caveman": {
      "source": {
        "source": "github",
        "repo": "JuliusBrussee/caveman",
        "ref": "v4.0.1"
      },
      "autoUpdate": false
    },
    "ponytail": {
      "source": {
        "source": "github",
        "repo": "DietrichGebert/ponytail",
        "ref": "v5.2.3"
      },
      "autoUpdate": false
    }
  },
  "outputStyle": "Learning",
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "allowUnsandboxedCommands": false,
    "network": {
      "allowedDomains": [
        "buf.build",
        "crates.io",
        "index.crates.io",
        "github.com",
        "*.github.com",
        "proxy.golang.org",
        "raw.githubusercontent.com",
        "static.crates.io",
        "sum.golang.org",
        "static.rust-lang.org"
      ]
    },
    "credentials": {
      "files": [
        {
          "path": "~/.aws",
          "mode": "deny"
        },
        {
          "path": "~/.cargo/credentials.toml",
          "mode": "deny"
        },
        {
          "path": "~/.config/gh",
          "mode": "deny"
        },
        {
          "path": "~/.config/sops",
          "mode": "deny"
        },
        {
          "path": "~/.docker/config.json",
          "mode": "deny"
        },
        {
          "path": "~/.git-credentials",
          "mode": "deny"
        },
        {
          "path": "~/.gnupg",
          "mode": "deny"
        },
        {
          "path": "~/.kube",
          "mode": "deny"
        },
        {
          "path": "~/.local/share/gnupg",
          "mode": "deny"
        },
        {
          "path": "~/.netrc",
          "mode": "deny"
        },
        {
          "path": "~/.npmrc",
          "mode": "deny"
        },
        {
          "path": "~/.ssh",
          "mode": "deny"
        }
      ]
    },
    "enableWeakerNetworkIsolation": true,
    "excludedCommands": [
      "docker compose exec *",
      "git fetch *",
      "git pull *",
      "git push *"
    ]
  },
  "spinnerTipsEnabled": true,
  "effortLevel": "low",
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "high"
    }
  },
  "tui": "fullscreen",
  "voice": {
    "enabled": true,
    "mode": "hold"
  },
  "showThinkingSummaries": true,
  "theme": "dark",
  "editorMode": "vim",
  "skipAutoPermissionPrompt": true,
  "worktree": {
    "baseRef": "head"
  }
}
