#!/usr/bin/env bash
# Test double for sops: "encrypt" puts a marker line above the input, "decrypt" drops it.
# The file is the last argument, as scripts/secrets.sh calls it.
# SOPS_CALLS, if set, is a file that gets one line per call.
command="${1:-}"

[[ -n "${SOPS_CALLS:-}" ]] && printf '%s\n' "${command}" >> "${SOPS_CALLS}"

case "${command}" in
    encrypt) printf 'ENC[AES256_GCM,data:fake]\n'; cat "${@: -1}" ;;
    decrypt) tail -n +2 "${@: -1}" ;;
    *) echo "sops mock: unsupported command: ${command}" >&2; exit 2 ;;
esac
